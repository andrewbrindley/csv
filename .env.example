# ---- Frontend env template ----
# Copy to .env.local and fill in values. .env.local is gitignored.

# Toggle Auth0 on/off. When false, the app uses a hardcoded super-admin user.
REACT_APP_AUTH0_ENABLED=true

# Auth0 application — the SPA app from your Auth0 dashboard
REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
REACT_APP_AUTH0_AUDIENCE=https://your-api-identifier/

# Backend API base
REACT_APP_API_URL=http://localhost:5000/api
