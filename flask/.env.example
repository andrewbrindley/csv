# ---- Backend env template ----
# Copy to flask/.env and fill in values. flask/.env is gitignored.

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=APPNAME
MONGO_DB_NAME=csv_app_local

# OpenAI
OPENAI_API_KEY=sk-...

# Auth0 — backend validates JWTs using these
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier/

# Flask
PORT=5000
FLASK_DEBUG=1

# AWS — leave blank for local dev. The active import flow does not require AWS.
# Set these in your AWS deployment environment (ECS task definition, etc).
AWS_REGION=
S3_UPLOAD_BUCKET=
SQS_QUEUE_URL=
